.vscode/
tmp/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
android/local.properties
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Pods/
macos/Flutter/ephemeral/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local ASR models are installed on-device and should not be committed.
*.ggml.bin
*.gguf
ggml-model-*.bin
/models/
/android/app/src/main/assets/models/
.spectra/
openspec/.vector-search.db*

# Spectra-generated command wrappers are local tool integrations. Keep the
# shared skills/specs, but do not duplicate command shims for every agent.
.agent/workflows/
.claude/settings.json
.cursor/commands/
.github/prompts/
.opencode/commands/
